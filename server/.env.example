# Copy to .env and edit, then:
#   home network:  docker compose up -d --build
#   internet:      docker compose -f docker-compose.public.yml up -d --build

# --- Who can create accounts ----------------------------------------------
# Default: nobody, except the very first account, which needs the one-time
# setup code printed by `docker logs nook-server` (also in /data/setup-code).
# To let family members register, set an invite code (at least 8 characters)
# and tell it to them; the apps ask for it on the sign-up screen.
NOOK_INVITE_CODE=
# true = anyone who can reach the server may register. Never on the internet.
NOOK_ALLOW_REGISTRATION=false
NOOK_MAX_USERS=20

# --- Internet deployment (docker-compose.public.yml) ----------------------
# Domain pointing at this machine; Caddy gets a Let's Encrypt certificate
# for it automatically (ports 80 and 443 must be reachable).
NOOK_DOMAIN=
# NOOK_HTTP_PORT=80
# NOOK_HTTPS_PORT=443
# Internal network for Nook <-> Caddy; change only if it clashes.
# NOOK_SUBNET=172.30.58.0/24
# NOOK_PROXY_IP=172.30.58.10

# --- Home network deployment (docker-compose.yml) -------------------------
NOOK_PORT=5858

# --- Limits ------------------------------------------------------------------
# Signed-in devices unused for this many days are signed out.
NOOK_SESSION_IDLE_DAYS=90
# Max photo upload size, and storage per account (photos + records), in MB.
NOOK_MAX_FILE_MB=20
NOOK_USER_QUOTA_MB=4096
NOOK_MEM_LIMIT=2g

# Rebuild with rembg for server-side cut-outs (true/false).
WITH_CUTOUT=false
NOOK_CUTOUT_MODEL=isnet-general-use
NOOK_CUTOUT_RATE_PER_HOUR=120

# --- AI icon drawing (Claude) ---------------------------------------------
# Leave empty to disable the feature.
ANTHROPIC_API_KEY=
# Optional: a proxy / gateway that speaks the Anthropic Messages API.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
NOOK_ICON_MODEL=claude-opus-5-5
NOOK_ICON_EFFORT=medium
# Server-side refusal fallback; set false if your gateway rejects beta headers.
NOOK_ICON_FALLBACKS=true
# Per account per hour, and for the whole server per day.
NOOK_ICON_RATE_PER_HOUR=60
NOOK_ICON_RATE_PER_DAY=300
