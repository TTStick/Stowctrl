# Copy to .env and edit, then: docker compose up -d --build

# Port on the host.
NOOK_PORT=5858

# Rebuild with rembg for server-side cut-outs (true/false).
WITH_CUTOUT=false

# After creating your own account(s), set to false to stop strangers from
# registering. The very first account can always be created.
NOOK_ALLOW_REGISTRATION=true

# Max photo upload size in MB.
NOOK_MAX_FILE_MB=20

# --- AI icon drawing (Claude) ---------------------------------------------
# Leave empty to disable the feature.
ANTHROPIC_API_KEY=
# Optional: a proxy / gateway that speaks the Anthropic Messages API.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
NOOK_ICON_MODEL=claude-opus-5-5
NOOK_ICON_EFFORT=medium
# Server-side refusal fallback; set false if your gateway rejects beta headers.
NOOK_ICON_FALLBACKS=true
NOOK_ICON_RATE_PER_HOUR=60

# Background-removal model for the rembg fallback.
NOOK_CUTOUT_MODEL=isnet-general-use
