# ONNX Runtime calls into Java through JNI.
-keep class ai.onnxruntime.** { *; }
# kotlinx.serialization ships its own rules; keep our serializable models' companions too.
-keepclassmembers class com.wanwu.nook.data.** { *** Companion; }
-keepclasseswithmembers class com.wanwu.nook.** { kotlinx.serialization.KSerializer serializer(...); }
-dontwarn org.slf4j.**
# Anthropic Java SDK: Jackson (de)serialises its models via reflection. Keep
# only what the app uses (messages, model listing, errors, core plumbing).
-keepattributes *Annotation*,Signature,InnerClasses,EnclosingMethod,Exceptions
-keep class kotlin.Metadata { *; }
-keep class com.anthropic.core.** { *; }
-keep class com.anthropic.errors.** { *; }
-keep class com.anthropic.models.* { *; }
-keep class com.anthropic.models.messages.** { *; }
-keep class com.anthropic.models.models.** { *; }
-keepclassmembers class * {
    @com.fasterxml.jackson.annotation.JsonCreator *;
    @com.fasterxml.jackson.annotation.JsonProperty *;
    @com.fasterxml.jackson.annotation.JsonAnySetter *;
    @com.fasterxml.jackson.annotation.JsonAnyGetter *;
}
-keep class com.fasterxml.jackson.databind.ext.** { *; }
-keep class com.fasterxml.jackson.module.kotlin.** { *; }
-dontwarn com.fasterxml.jackson.**
-dontwarn java.beans.**
-dontwarn kotlin.reflect.jvm.internal.**
-dontwarn org.apache.hc.**
-dontwarn org.brotli.**
-dontwarn org.conscrypt.**

# Generated by R8 (missing_rules.txt): reflection APIs used only by the SDK's JSON Schema helper, unused here.
-dontwarn java.lang.reflect.AnnotatedParameterizedType
-dontwarn java.lang.reflect.AnnotatedType
